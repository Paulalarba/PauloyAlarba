{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "paul-portfolio-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
  // Set TURNSTILE_SECRET_KEY using Cloudflare Secrets, never in this file.
  // Choose an unused namespace_id if 1001 already serves another account limit.
}
